# ─── Server ───────────────────────────────────────────────
PORT=5001

# ─── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret
JWT_EXPIRES_IN=7d

# ─── Session (Passport) ───────────────────────────────────
SESSION_SECRET=change_this_to_a_random_session_secret

# ─── Google OAuth 2.0 ─────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI (local dev): http://localhost:5001/auth/google/callback
# Authorised redirect URI (prod):      https://<your-backend>.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
