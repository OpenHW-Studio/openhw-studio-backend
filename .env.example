# ─── Server ───────────────────────────────────────────────
PORT=5001
EXAMPLES_PATH=../path-to-openhw-studio-examples/examples
EXAMPLES_DIR=/app/openhw-studio-examples/examples
EMULATOR_PATH=../path-to-openhw-studio-emulator
# Optional direct override if you want to point straight at the component folder.
# EMULATOR_COMPONENTS_PATH=../path-to-openhw-studio-emulator/src/components


# ─── Database ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/openhw-studio-local

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Session (Passport) ───────────────────────────────────
SESSION_SECRET=your_session_secret_here

# ─── Google OAuth 2.0 ─────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback
GOOGLE_CALLBACK_URL=https://openhw-studio.fossee.in/auth/google/callback

# ─── Frontend ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://openhw-studio.fossee.in,http://localhost:5173,http://localhost:5001
# FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://openhw-studio.fossee.in

# ─── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=poojitha.srinivasan.05@gmail.com
