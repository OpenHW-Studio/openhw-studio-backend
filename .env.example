PORT=5001
EXAMPLES_PATH=../openhw-studio-examples/examples
EXAMPLES_DIR=/app/openhw-studio-examples/examples
EMULATOR_PATH=../openhw-studio-emulator

# Your own MongoDB. Local dev: mongodb://127.0.0.1:27017/openhw-studio-local
# Production: your own mongodb:// or mongodb+srv:// connection string.
# Never commit real credentials — this file is public.
MONGO_URI=mongodb://127.0.0.1:27017/openhw-studio-local

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=xxxx
JWT_EXPIRES_IN=7d

# ─── Session (Passport) ───────────────────────────────────
SESSION_SECRET=xxx

# ─── Google OAuth 2.0 ─────────────────────────────────────
# Replace these with your actual credentials from Google Cloud Console
GOOGLE_CLIENT_ID=xxx-xxx.xxx.xxx.com
GOOGLE_CLIENT_SECRET=xxx-xxx

# GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback (for localhost deployment)
GOOGLE_CALLBACK_URL=https://openhw-studio.fossee.in/auth/google/callback

# ─── Frontend ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://openhw-studio.fossee.in,http://localhost:5173,http://localhost:5001
# Canonical server-side admin allowlist. VITE_ADMIN_EMAILS is still honored
# as a legacy fallback — set ADMIN_EMAILS on your own deploy, never commit
# real addresses here.
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://openhw-studio.fossee.in

# ─── Email / SMTP (OTP Verification) ──────────────────────
# Used to send 6-digit OTP codes for email verification during signup.
# If these are left blank, emails are NOT sent in development — instead
# the OTP is printed to the backend terminal console (great for local testing).
#
# Option A: Gmail with an App Password
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to: Google Account → Security → App Passwords → create one.
#   3. Use the 16-char app password (no spaces) as SMTP_PASSWORD.
#
# Option B: Any SMTP service (Brevo, SendGrid, Mailgun, etc.)
#   Just replace host/port/credentials accordingly.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_NAME=OpenHW Studio
FROM_EMAIL=your-gmail@gmail.com



# RP2040 simulator MicroPython firmware (must be UART0 REPL capable)
# Set to an HTTPS URL or a local file path RELATIVE to backend root.
PICO_MICROPYTHON_UART0_UF2_URL=path_to_pico-micropython-uart0.uf2

# RP2040 simulator MicroPython HEX image (used for direct HEX runtime loading)
PICO_MICROPYTHON_HEX_PATH=path_to_rp2040-micropython-uart.hex

# RP2040 simulator CircuitPython firmware (pinned for bundled-lib compatibility)
PICO_CIRCUITPYTHON_UF2_PATH=path_to_adafruit-circuitpython-raspberry_pi_pico-en_US-8.2.7.uf2

# ─── Compiler worker ──────────────────────────────────────────
# ROLE=main proxies compile execution to this URL; ROLE=compiler serves it.
# Local dev leaves both unset and compiles in-process.
COMPILER_WORKER_HTTP_URL=http://localhost:5001

# ─── Data root (library pool, compile support files) ──────────
# Absolute path or relative to openhw-studio-backend/. Defaults to ./data
# (which is /app/data in Docker via the persistent volume).
# DATA_ROOT=./data

# ─── Cache storage limits (all sizes in MB, LRU-evicted past the cap) ──
# LIB_CACHE_MAX_MB / LIB_CACHE_TARGET_MB ....... library downloads
#   (data/libraries/cache; default cap 512, prune to 400)
# RESULT_CACHE_MAX_MB / RESULT_CACHE_TARGET_MB . compiled firmware
#   (temp/compile-results; default cap 500, prune to 400)
# COMPILE_RESULT_TTL_MS / COMPILE_RESULT_CACHE_MAX  in-memory result entries
#   (default 30 min TTL, 120 entries)
# COMPILE_WORKSPACE_TTL_MS / COMPILE_WORKSPACE_MAX  live build workspaces
#   (default 12 h TTL, 48 workspaces)
# COMPILE_MAX_FILES / COMPILE_MAX_FILE_BYTES / COMPILE_MAX_TOTAL_BYTES
#   input size guards (defaults 64 files, 256 KB/file, 512 KB total)
# COMPILE_RATE_LIMIT_PER_MIN — per-IP cap on guest compile POSTs (default 20)
# LIB_CACHE_MAX_MB=512
# LIB_CACHE_TARGET_MB=400
# RESULT_CACHE_MAX_MB=500
# RESULT_CACHE_TARGET_MB=400
# COMPILE_RATE_LIMIT_PER_MIN=20

# ─── Compile pool sizing (compiler-worker only) ─────────────────────
# COMPILE_POOL_MB .... total compile pool in MB (default 8192 = 8 GB worker)
# COMPILE_RESERVE_MB . headroom kept free inside the pool (default 1024)
# COMPILE_PROXY_ATTEMPTS / COMPILE_PROXY_RETRY_MS .. main→worker retries
#   (default 3 attempts, 300 ms apart, then 502)
# COMPILE_POOL_MB=8192
# COMPILE_RESERVE_MB=1024

# ─── Deploy branch (CI + dashboard triggers) ────────────────────────
# Must match the branch your deploy.yml/rollback.yml listen on.
# DEPLOY_BRANCH=develop

DOCKER_USERNAME=xxx